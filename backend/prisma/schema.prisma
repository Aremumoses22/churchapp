  GROUP

  @@map("conversation_type")
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  SYSTEM

  @@map("message_type")
}

enum ConversationRole {
  MEMBER
  ADMIN

  @@map("conversation_role")
}

enum NotificationType {
  SERMON
  EVENT
  CHAT
  GIVING
  PRAYER
  ANNOUNCEMENT
  GROUP
  FORUM
  VOLUNTEER
  KIDS
  DEVOTIONAL
  PERSONAL
  SECURITY
  SYSTEM

  @@map("notification_type")
}

enum LiveServiceStatus {
  SCHEDULED
  LIVE
  ENDED

  @@map("live_service_status")
}

enum LiveChatType {
  MESSAGE
  PRAYER
  REACTION

  @@map("live_chat_type")
}

// ─────────────────────────────────────────────────────
// CONVERSATIONS (Chat)
// ─────────────────────────────────────────────────────
model Conversation {
  id            String           @id @default(uuid()) @db.Uuid
  churchId      String           @map("church_id") @db.Uuid
  type          ConversationType
  name          String?          @db.VarChar(255)
  imageUrl      String?          @map("image_url") @db.VarChar(500)
  createdById   String           @map("created_by_id") @db.Uuid
  lastMessageAt DateTime?        @map("last_message_at") @db.Timestamptz()
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  createdBy User                 @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members   ConversationMember[]
  messages  Message[]

  @@index([churchId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           ConversationRole @default(MEMBER)
  isPinned       Boolean          @default(false) @map("is_pinned")
  isMuted        Boolean          @default(false) @map("is_muted")
  lastReadAt     DateTime?        @map("last_read_at") @db.Timestamptz()
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz()
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid
  content        String      @db.Text
  type           MessageType @default(TEXT)
  mediaUrl       String?     @map("media_url") @db.VarChar(500)
  replyToId      String?     @map("reply_to_id") @db.Uuid
  isEdited       Boolean     @default(false) @map("is_edited")
  isDeleted      Boolean     @default(false) @map("is_deleted")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReply")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// ─────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(255)
  body      String           @db.Text
  data      Json             @default("{}") // {entityId, entityType, deepLink}
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at") @db.Timestamptz()
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────
// LIVE SERVICE
// ─────────────────────────────────────────────────────
model LiveService {
  id           String            @id @default(uuid()) @db.Uuid
  churchId     String            @map("church_id") @db.Uuid
  title        String            @db.VarChar(255)
  description  String?           @db.Text
  streamUrl    String?           @map("stream_url") @db.VarChar(500)
  status       LiveServiceStatus @default(SCHEDULED)
  scheduledAt  DateTime          @map("scheduled_at") @db.Timestamptz()
  startedAt    DateTime?         @map("started_at") @db.Timestamptz()
  endedAt      DateTime?         @map("ended_at") @db.Timestamptz()
  viewerCount  Int               @default(0) @map("viewer_count")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  church       Church            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  chatMessages LiveChatMessage[]

  @@index([churchId, status])
  @@index([scheduledAt])
  @@map("live_services")
}

model LiveChatMessage {
  id            String       @id @default(uuid()) @db.Uuid
  liveServiceId String       @map("live_service_id") @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  content       String       @db.Text
  type          LiveChatType @default(MESSAGE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  liveService LiveService @relation(fields: [liveServiceId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([liveServiceId, createdAt])
  @@index([userId])
  @@map("live_chat_messages")
}

// ═══════════════════════════════════════════════════════════════
// Phase 6: Volunteering, Media & Search
// ═══════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────
// ENUMS (Phase 6)
// ─────────────────────────────────────────────────────
enum VolunteerSignupStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("volunteer_signup_status")
}

enum ShiftStatus {
  SCHEDULED
  CHECKED_IN
  COMPLETED
  SWAPPED

  @@map("shift_status")
}

enum CheckInStatus {
  CHECKED_IN
  CHECKED_OUT

  @@map("checkin_status")
}

enum SongSectionType {
  VERSE
  CHORUS
  BRIDGE
  PRE_CHORUS
  OUTRO
  INTRO

  @@map("song_section_type")
}

// ─────────────────────────────────────────────────────
// VOLUNTEERING
// ─────────────────────────────────────────────────────
model VolunteerOpportunity {
  id           String   @id @default(uuid()) @db.Uuid
  churchId     String   @map("church_id") @db.Uuid
  title        String   @db.VarChar(255)
  description  String?  @db.Text
  department   String   @db.VarChar(100)        // Media, Worship, Ushering, Children, Technical
  requirements String?  @db.Text
  imageUrl     String?  @map("image_url") @db.VarChar(500)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  church  Church             @relation(fields: [churchId], references: [id], onDelete: Cascade)
  signups VolunteerSignup[]
  shifts  RosterShift[]

  @@index([churchId])
  @@index([department])
  @@map("volunteer_opportunities")
}

model VolunteerSignup {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  opportunityId String                @map("opportunity_id") @db.Uuid
  status        VolunteerSignupStatus @default(PENDING)
  appliedAt     DateTime              @default(now()) @map("applied_at") @db.Timestamptz()
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity VolunteerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([opportunityId])
  @@map("volunteer_signups")
}

model RosterShift {
  id            String      @id @default(uuid()) @db.Uuid
  churchId      String      @map("church_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  opportunityId String      @map("opportunity_id") @db.Uuid
  date          DateTime    @db.Date
  startTime     String      @map("start_time") @db.VarChar(10) // "09:00"
  endTime       String      @map("end_time") @db.VarChar(10)   // "12:00"
  status        ShiftStatus @default(SCHEDULED)
  checkinAt     DateTime?   @map("checkin_at") @db.Timestamptz()
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  church      Church               @relation(fields: [churchId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity VolunteerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([churchId, date])
  @@index([opportunityId])
  @@map("roster_shifts")
}

// ─────────────────────────────────────────────────────
// KIDS CHECK-IN
// ─────────────────────────────────────────────────────
model Child {
  id           String    @id @default(uuid()) @db.Uuid
  parentId     String    @map("parent_id") @db.Uuid
  churchId     String    @map("church_id") @db.Uuid
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  dateOfBirth  DateTime  @map("date_of_birth") @db.Date
  allergies    String?   @db.Text
  medicalNotes String?   @map("medical_notes") @db.Text
  photoUrl     String?   @map("photo_url") @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  parent   User      @relation(fields: [parentId], references: [id], onDelete: Cascade)
  church   Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  checkIns CheckIn[]

  @@index([parentId])
  @@index([churchId])
  @@map("children")
}

model Room {
  id           String   @id @default(uuid()) @db.Uuid
  churchId     String   @map("church_id") @db.Uuid
  name         String   @db.VarChar(255)
  ageGroup     String   @map("age_group") @db.VarChar(100) // "0-2", "3-5", "6-8", "9-12"
  capacity     Int
  currentCount Int      @default(0) @map("current_count")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  church   Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  checkIns CheckIn[]

  @@index([churchId])
  @@map("rooms")
}

model CheckIn {
  id           String        @id @default(uuid()) @db.Uuid
  childId      String        @map("child_id") @db.Uuid
  roomId       String        @map("room_id") @db.Uuid
  parentId     String        @map("parent_id") @db.Uuid
  checkedInBy  String        @map("checked_in_by") @db.Uuid
  securityCode String        @map("security_code") @db.VarChar(10) // 6-digit code
  status       CheckInStatus @default(CHECKED_IN)
  checkedInAt  DateTime      @default(now()) @map("checked_in_at") @db.Timestamptz()
  checkedOutAt DateTime?     @map("checked_out_at") @db.Timestamptz()
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  child       Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  room        Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  parent      User  @relation("CheckInParent", fields: [parentId], references: [id], onDelete: Cascade)
  checkedInByUser User @relation("CheckInOperator", fields: [checkedInBy], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([roomId])
  @@index([parentId])
  @@index([securityCode])
  @@map("check_ins")
}

// ─────────────────────────────────────────────────────
// MEDIA (Photos, Podcasts, Worship Songs)
// ─────────────────────────────────────────────────────
model PhotoAlbum {
  id            String   @id @default(uuid()) @db.Uuid
  churchId      String   @map("church_id") @db.Uuid
  title         String   @db.VarChar(255)
  description   String?  @db.Text
  coverImageUrl String?  @map("cover_image_url") @db.VarChar(500)
  photoCount    Int      @default(0) @map("photo_count")
  eventId       String?  @map("event_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  church Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  event  Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  photos Photo[]

  @@index([churchId])
  @@index([eventId])
  @@map("photo_albums")
}

model Photo {
  id           String   @id @default(uuid()) @db.Uuid
  albumId      String   @map("album_id") @db.Uuid
  churchId     String   @map("church_id") @db.Uuid
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  imageUrl     String   @map("image_url") @db.VarChar(500)
  thumbnailUrl String?  @map("thumbnail_url") @db.VarChar(500)
  caption      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  album      PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  church     Church     @relation(fields: [churchId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@index([churchId])
  @@map("photos")
}

model PodcastEpisode {
  id           String   @id @default(uuid()) @db.Uuid
  churchId     String   @map("church_id") @db.Uuid
  title        String   @db.VarChar(255)
  description  String?  @db.Text
  audioUrl     String   @map("audio_url") @db.VarChar(500)
  duration     Int                                        // in seconds
  thumbnailUrl String?  @map("thumbnail_url") @db.VarChar(500)
  publishedAt  DateTime @map("published_at") @db.Timestamptz()
  playCount    Int      @default(0) @map("play_count")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  church   Church                @relation(fields: [churchId], references: [id], onDelete: Cascade)
  progress UserPodcastProgress[]

  @@index([churchId])
  @@index([publishedAt])
  @@map("podcast_episodes")
}

model UserPodcastProgress {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  episodeId String   @map("episode_id") @db.Uuid
  position  Int      @default(0) // seconds
  completed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@map("user_podcast_progress")
}

model WorshipSong {
  id        String   @id @default(uuid()) @db.Uuid
  churchId  String   @map("church_id") @db.Uuid
  title     String   @db.VarChar(255)
  artist    String   @db.VarChar(255)
  key       String?  @db.VarChar(10)  // "C", "G", "Am"
  tempo     Int?                       // BPM
  tags      String[] @default([])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  church   Church        @relation(fields: [churchId], references: [id], onDelete: Cascade)
  sections SongSection[]

  @@index([churchId])
  @@map("worship_songs")
}

model SongSection {
  id        String          @id @default(uuid()) @db.Uuid
  songId    String          @map("song_id") @db.Uuid
  type      SongSectionType
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  song  WorshipSong @relation(fields: [songId], references: [id], onDelete: Cascade)
  lines LyricLine[]

  @@index([songId])
  @@map("song_sections")
}

model LyricLine {
  id         String   @id @default(uuid()) @db.Uuid
  sectionId  String   @map("section_id") @db.Uuid
  lineNumber Int      @map("line_number")
  lyrics     String   @db.Text
  chords     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  section SongSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@map("lyric_lines")
}

// ═══════════════════════════════════════════════════════════════
// Phase 7: Polish, Jobs & Testing
// ═══════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────
// ATTENDANCE TRACKING
// ─────────────────────────────────────────────────────
model Attendance {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  churchId      String         @map("church_id") @db.Uuid
  serviceDate   DateTime       @map("service_date") @db.Date
  serviceType   ServiceType    @default(SUNDAY) @map("service_type")
  checkinMethod CheckinMethod  @default(MANUAL) @map("checkin_method")
  notes         String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceDate, serviceType])
  @@index([churchId])
  @@index([userId])
  @@index([serviceDate])
  @@map("attendances")
}

// ─────────────────────────────────────────────────────
// SPIRITUAL MILESTONES
// ─────────────────────────────────────────────────────
model SpiritualMilestone {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  churchId    String        @map("church_id") @db.Uuid
  type        MilestoneType
  title       String        @db.VarChar(255)
  description String?       @db.Text
  achievedAt  DateTime      @default(now()) @map("achieved_at") @db.Timestamptz()
  iconUrl     String?       @map("icon_url") @db.VarChar(500)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([churchId])
  @@map("spiritual_milestones")
}

// ─────────────────────────────────────────────────────
// SAVED ITEMS (polymorphic bookmarks)
// ─────────────────────────────────────────────────────
model SavedItem {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  entityType SavedEntityType @map("entity_type")
  entityId   String         @map("entity_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@index([entityType, entityId])
  @@map("saved_items")
}

// ─────────────────────────────────────────────────────
// Phase 7 Enums
