  @@map("service_type")
}

enum CheckinMethod {
  MANUAL
  QR
  GEOFENCE

  @@map("checkin_method")
}

enum MilestoneType {
  SALVATION
  BAPTISM
  FIRST_SERVE
  SMALL_GROUP
  MINISTRY_LEADER
  FIRST_GIVE
  ONE_YEAR
  INVITE_FRIEND

  @@map("milestone_type")
}

enum SavedEntityType {
  SERMON
  EVENT
  DEVOTIONAL
  VERSE
  THREAD
  SONG

  @@map("saved_entity_type")
}